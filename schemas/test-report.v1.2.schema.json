{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2etester.local/schemas/test-report.v1.2.schema.json",
  "title": "E2ETester report 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "exportedAt",
    "provisional",
    "applicationVersion",
    "targetBuild",
    "summary",
    "coverage",
    "checkEvidence",
    "redactions",
    "run"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "reportId": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "provisional": {
      "type": "boolean"
    },
    "applicationVersion": {
      "type": "string"
    },
    "targetBuild": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "checkEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reportCheck"
      }
    },
    "redactions": {
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/run"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "sensitive": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "name"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "default": "GET",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "default": "/",
          "minLength": 1
        },
        "query": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "body": {
          "type": "string"
        },
        "contentType": {
          "type": "string",
          "default": "application/json"
        },
        "sendBody": {
          "type": "boolean"
        },
        "bodySensitive": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 30
        },
        "identityRef": {
          "type": "string",
          "default": "none"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "status",
            "bodyContains",
            "jsonEquals",
            "headerEquals"
          ],
          "default": "status"
        },
        "selector": {
          "type": "string",
          "description": "JSON Pointer for jsonEquals; header name for headerEquals."
        },
        "expected": {
          "type": "string",
          "default": "200"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "fixtureQueryId": {
          "type": "string"
        },
        "databaseChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/databaseCheck"
          }
        }
      }
    },
    "parameter": {
      "properties": {
        "type": {
          "enum": [
            "string",
            "int64",
            "decimal",
            "boolean",
            "guid",
            "dateTimeOffset"
          ]
        },
        "sensitive": {
          "type": "boolean"
        },
        "isNull": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^@?[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "query": {
      "properties": {
        "title": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "maximum": 600,
          "type": "integer",
          "minimum": 1
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "sensitiveColumns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rowLimit": {
          "maximum": 10000,
          "type": "integer",
          "minimum": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "connectionRef": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "sqlite",
            "sqlServer",
            "mySql",
            "postgreSql"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "databaseCheck": {
      "properties": {
        "required": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "rowCount",
            "scalarEquals"
          ]
        },
        "expectedJson": {
          "type": "string"
        },
        "queryId": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "package": {
      "title": "E2ETester database package 1.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "title",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/query"
          }
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "verdict",
        "expected",
        "actual",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "verifiedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject",
        "displayName",
        "expiresAt",
        "source"
      ],
      "properties": {
        "issuer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "const": "validated_oidc_id_token"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statusCode",
        "headers",
        "body",
        "truncated",
        "capturedBytes",
        "durationMs",
        "errorCode",
        "error"
      ],
      "properties": {
        "statusCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "body": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "capturedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "queryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "durationMs",
        "columns",
        "rows",
        "truncated",
        "errorCode",
        "error"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "dataType"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "dataType": {
                "type": "string"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "queryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "query",
        "result",
        "checkId",
        "assessment",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/query"
        },
        "result": {
          "$ref": "#/$defs/queryResult"
        },
        "checkId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/checkResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "enum": [
            "exploration",
            "verification"
          ]
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "rowIndex"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/queryEvidence"
        },
        "rowIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "caseId",
        "caseTitle",
        "startedAt",
        "finishedAt",
        "state",
        "verdict",
        "identityAlias",
        "authKind",
        "verifiedIdentity",
        "effectiveUrl",
        "request",
        "changes",
        "assertions",
        "response",
        "checks",
        "fixture",
        "databasePlans",
        "databaseEvidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        },
        "caseTitle": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "running",
            "completed",
            "cancelled",
            "interrupted"
          ]
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "identityAlias": {
          "type": "string"
        },
        "authKind": {
          "enum": [
            "none",
            "bearer",
            "apiToken"
          ]
        },
        "verifiedIdentity": {
          "anyOf": [
            {
              "$ref": "#/$defs/verifiedIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveUrl": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "original",
              "current"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "original": {
                "type": "string"
              },
              "current": {
                "type": "string"
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/response"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkResult"
          }
        },
        "fixture": {
          "anyOf": [
            {
              "$ref": "#/$defs/fixture"
            },
            {
              "type": "null"
            }
          ]
        },
        "databasePlans": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "query"
            ],
            "properties": {
              "check": {
                "$ref": "#/$defs/databaseCheck"
              },
              "query": {
                "$ref": "#/$defs/query"
              }
            }
          }
        },
        "databaseEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queryEvidence"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startedAt",
        "finishedAt",
        "packageHash",
        "package",
        "baseUrl",
        "attempts"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "packageHash": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "baseUrl": {
          "type": "string"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "totalCases",
        "executedCases",
        "attempts",
        "hadFailures",
        "effectiveAttemptPolicy"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "totalCases": {
          "type": "integer",
          "minimum": 0
        },
        "executedCases": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "hadFailures": {
          "type": "boolean"
        },
        "effectiveAttemptPolicy": {
          "const": "latest attempt per case; all historical attempts retained"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "title",
        "parentId",
        "attemptId",
        "verdict",
        "state"
      ],
      "properties": {
        "caseId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "fail",
                "inconclusive"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "NotRun",
            "Running",
            "Completed",
            "Cancelled",
            "Interrupted"
          ]
        }
      }
    },
    "reportCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "checkId",
        "required",
        "verdict",
        "expected",
        "actual",
        "expectedText",
        "actualText",
        "message",
        "evidencePointer"
      ],
      "properties": {
        "attemptId": {
          "type": "string"
        },
        "checkId": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "expected": {},
        "actual": {},
        "expectedText": {
          "type": "string"
        },
        "actualText": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "evidencePointer": {
          "type": "string",
          "pattern": "^/run/attempts/[0-9]+/checks/[0-9]+$"
        }
      }
    }
  }
}
