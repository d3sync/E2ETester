<Window x:Class="E2ETester.Desktop.UnsavedChangesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Save before exiting?" Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="24"><TextBlock Text="Save your changes before exiting?" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="You have test or query edits since your last explicit save. Save and exit preserves the current draft locally so you can continue next time."/><TextBlock Margin="0,10,0,20" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="Recorded attempts are already saved. Exit without saving skips the final save; earlier automatic recovery copies may remain. Credentials are excluded from drafts; use a saved environment to retain API tokens."/><WrapPanel HorizontalAlignment="Right"><Button Content="Save and exit" Style="{StaticResource Primary}" Click="Save"/><Button Content="Cancel" Click="Cancel" IsCancel="True" IsDefault="True"/><Button Content="Exit without saving" Click="Discard"/></WrapPanel></StackPanel>
</Window>
