<Window x:Class="E2ETester.Desktop.SwaggerLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Sign in through Swagger" Width="1180" Height="820" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Sign in and authorize in Swagger" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Read the authorized Swagger token, or use Try it out on a read-only API request. Cookies and sign-in data are remembered for this identity. Edge can offer to save passwords. For Microsoft, choose Stay signed in when offered; MFA may still be required by your organization." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8"/><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Open Swagger" Click="OpenSwagger"/><TextBox x:Name="Address"/></DockPanel></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Opening Edge WebView2…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><WrapPanel Margin="0,10,0,0"><Button x:Name="ReadToken" Content="Read authorized token" Click="ReadAuthorizedToken" IsEnabled="False"/><Button x:Name="UseToken" Content="Use token for selected identity" Style="{StaticResource Primary}" IsEnabled="False" Click="UseCapturedToken"/><Button Content="Back" Click="GoBack"/><Button Content="Reload" Click="ReloadPage"/><Button Content="Clear saved sign-in data" Click="ClearSession"/><Button Content="Close" Click="CloseWindow"/></WrapPanel></StackPanel>
  <wv:WebView2 x:Name="Browser"/>
 </DockPanel>
</Window>
