<Window x:Class="E2ETester.Desktop.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Workspace" Width="760" Height="620" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="24"><TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{DynamicResource Muted}"/><TabControl>
  <TabItem Header="Package library"><DockPanel Margin="14"><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="Save current package snapshot" Command="{Binding SaveLibrary}"/><Button Content="Open selected" Command="{Binding LoadLibrary}"/></WrapPanel><ListBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedLibrary}" DisplayMemberPath="Title"/></DockPanel></TabItem>
  <TabItem Header="Environments"><StackPanel Margin="18"><TextBlock Text="Store the current base URL, named identities and database connections for this Windows account." TextWrapping="Wrap"/><TextBlock Text="Environment name" Margin="0,16,0,6"/><ComboBox ItemsSource="{Binding Environments}" IsEditable="True" Text="{Binding EnvironmentName, UpdateSourceTrigger=PropertyChanged}"/><WrapPanel Margin="0,16"><Button Content="Save current settings" Command="{Binding SaveEnvironment}"/><Button Content="Load selected" Command="{Binding LoadEnvironment}"/><Button Content="Remove saved" Command="{Binding ForgetEnvironment}"/></WrapPanel><TextBlock Text="Manual tokens and connection strings are encrypted with Windows user protection. Swagger browser cookies persist separately; native OIDC token sessions stay in memory. Loading an environment requires a new run. These profiles never enter exported packages or reports." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></StackPanel></TabItem>
  <TabItem Header="Maintenance"><StackPanel Margin="18"><TextBlock Text="Backups contain test evidence and may contain business data. Credentials are stored separately. Runs are never deleted automatically." TextWrapping="Wrap"/><WrapPanel Margin="0,18"><Button Content="Load local database demo" Command="{Binding LoadDatabaseDemo}"/><Button Content="Updates / rollback" Command="{Binding OpenUpdates}"/><Button Content="Back up workspace" Command="{Binding BackupWorkspace}"/><Button Content="Export diagnostics" Command="{Binding ExportDiagnostics}"/></WrapPanel><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True"/><TextBlock Text="To remove a finished run, use Saved runs. A run linked to the current draft must be closed first." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16"/></StackPanel></TabItem>
 </TabControl></DockPanel>
</Window>
