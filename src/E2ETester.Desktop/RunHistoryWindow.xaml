<Window x:Class="E2ETester.Desktop.RunHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Saved runs" Width="940" Height="540" MinWidth="760" MinHeight="400" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Saved runs" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Open a session to review its evidence or continue unfinished testing." Margin="0,8,0,4"/><TextBlock Text="Opening replaces current unsaved edits. Requests are never replayed; credentials must be re-entered." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel>
  <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}" IsReadOnly="True" SelectionMode="Single" CanUserDeleteRows="False" CanUserSortColumns="False"><DataGrid.Columns>
   <DataGridTextColumn Header="Package" Binding="{Binding Title}" Width="2*"/>
   <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="175"/>
   <DataGridTextColumn Header="Base URL" Binding="{Binding BaseUrl}" Width="2*"/>
   <DataGridTextColumn Header="Attempts" Binding="{Binding AttemptCount}" Width="70"/>
   <DataGridTextColumn Header="Finished" Binding="{Binding FinishedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=Unfinished}" Width="130"/>
  </DataGrid.Columns></DataGrid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Remove finished" Command="{Binding Delete}"/><Button Content="Newer" Command="{Binding Newer}"/><Button Content="Older" Command="{Binding Older}"/><Button Content="Open selected" Command="{Binding Open}" Style="{StaticResource Primary}"/></StackPanel></Grid>
 </Grid>
</Window>
