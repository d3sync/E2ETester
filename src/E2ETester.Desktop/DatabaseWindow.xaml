<Window x:Class="E2ETester.Desktop.DatabaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:E2ETester.Desktop" Title="Query Studio · E2E Tester" Width="1140" Height="830" MinWidth="950" MinHeight="680" WindowStartupLocation="CenterOwner">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="QUERY STUDIO" Style="{StaticResource Caption}"/><TextBlock Text="Fixtures &amp; database evidence" FontSize="24" FontWeight="SemiBold"/></StackPanel><Button Grid.Column="1" Content="Use selected fixture" Command="{Binding SelectFixture}" Style="{StaticResource Primary}" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="CONNECTION PROFILE" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" DisplayMemberPath="Alias"/><Button Content="+ Connection" Command="{Binding AddConnection}" Margin="0,9,0,8"/>
    <UniformGrid Columns="2" Margin="0,0,0,8"><Button Content="Edit…" Command="{Binding EditConnection}"/><Button Content="Delete" Command="{Binding DeleteConnection}"/></UniformGrid>
    <TextBlock Text="{Binding ConnectionRestriction}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
    <Expander Header="Advanced connection settings" Margin="0,8,0,12" IsEnabled="{Binding CanEditSelectedConnection}"><StackPanel>
    <TextBlock Text="Alias (matches query connection)"/><TextBox IsReadOnly="True" Text="{Binding SelectedConnection.Alias, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
    <ComboBox ItemsSource="{x:Static local:DatabaseViewModel.Providers}" SelectedItem="{Binding SelectedConnection.Provider}"/><TextBlock Text="Connection string · memory only" Margin="0,14,0,6"/><PasswordBox x:Name="ConnectionBox" PasswordChanged="ConnectionChanged"/>
    <Button Content="Choose SQLite file…" Command="{Binding BrowseSqlite}" Margin="0,8,0,12"/>
    <CheckBox IsChecked="{Binding SelectedConnection.ReadOnlyCredentialsConfirmed}"><TextBlock Text="Read-only account (optional; disables preparation)." TextWrapping="Wrap"/></CheckBox>
    <TextBlock Text="Write-capable accounts are supported. SQLite is read-only; MySQL/PostgreSQL use read-only transactions. SQL Server relies on account permissions. Use SELECT queries here and Prepare for planned changes." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,14"/>
    </StackPanel></Expander>
    <Button Content="Test connection" Command="{Binding TestConnection}"/>
    <Separator Margin="0,20"/><TextBlock Text="SAVED PACKAGE QUERIES" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Queries}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedQuery}"/><StackPanel Orientation="Horizontal" Margin="0,10"><Button Content="New" Command="{Binding NewQuery}"/><Button Content="Save query" Command="{Binding SaveQuery}"/></StackPanel>
    <TextBlock Text="Queries freeze when a run starts. You can still explore, but saving package changes requires a new run." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/>
   </StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox Text="{Binding Draft.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold" IsEnabled="{Binding CanEdit}"/>
    <Grid Grid.Row="1" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox Text="{Binding Draft.ConnectionRef, UpdateSourceTrigger=PropertyChanged}" ToolTip="Connection alias" Margin="0,0,8,0"/><ComboBox Grid.Column="1" ItemsSource="{x:Static local:DatabaseViewModel.Providers}" SelectedItem="{Binding Draft.Provider}" Margin="0,0,8,0"/><TextBox Grid.Column="2" Text="{Binding Draft.RowLimit}" ToolTip="Maximum rows" Margin="0,0,8,0"/><TextBox Grid.Column="3" Text="{Binding Draft.TimeoutSeconds}" ToolTip="Timeout seconds"/></Grid>
    <TextBox Grid.Row="2" Text="{Binding Draft.Sql, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}"/>
    <DataGrid Grid.Row="3" ItemsSource="{Binding Parameters}" Margin="0,10,0,0" CanUserDeleteRows="True" IsEnabled="{Binding CanEdit}"><DataGrid.Columns><DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*"/><DataGridComboBoxColumn Header="Type" ItemsSource="{x:Static local:DatabaseViewModel.ParameterTypes}" SelectedItemBinding="{Binding Type}" Width="115"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/><DataGridCheckBoxColumn Header="Null" Binding="{Binding IsNull}"/></DataGrid.Columns></DataGrid>
    <Grid Grid.Row="4" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="+ Parameter" Command="{Binding AddParameter}"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Run query" Command="{Binding RunQuery}" Style="{StaticResource Primary}"/><Button Content="Cancel" Command="{Binding Cancel}"/></StackPanel></Grid>
    <DataGrid x:Name="ResultsGrid" Grid.Row="5" ItemsSource="{Binding ResultView}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="True" AutoGeneratingColumn="ResultColumn" SelectionMode="Single" SelectionUnit="FullRow"/>
    <Button Grid.Row="6" Content="Attach result to selected API attempt" Command="{Binding Attach}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
 </Grid>
</Window>
