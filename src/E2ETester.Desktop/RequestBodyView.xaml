<UserControl x:Class="E2ETester.Desktop.RequestBodyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:E2ETester.Desktop">
 <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><WrapPanel><CheckBox Content="Send body" IsChecked="{Binding SelectedCase.SendBody}" Margin="0,0,12,8"/><CheckBox Content="Use session cookies" IsChecked="{Binding SelectedCase.UseCookies}" Margin="12,0,0,0"/></WrapPanel><ComboBox ItemsSource="{x:Static local:CaseEditor.BodyKinds}" SelectedItem="{Binding SelectedCase.BodyKind}"/><TextBox Text="{Binding SelectedCase.ContentType}" Margin="0,8" ToolTip="Content type for text and binary bodies; form modes set their own content type."/></StackPanel>
  <TextBlock Grid.Row="1" Text="Text: raw JSON, XML or text. Binary: base64 bytes. Form modes use the fields below. Files are embedded in the package (up to 1 MB per file)." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/>
  <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedCase.BodyTabIndex, Mode=OneWay}"><TabItem Header="Text / binary"><DockPanel><Button DockPanel.Dock="Bottom" Content="Load binary file" Click="LoadBinary" HorizontalAlignment="Left"/><TextBox Text="{Binding SelectedCase.Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
   <TabItem Header="Form / multipart"><DockPanel><WrapPanel DockPanel.Dock="Bottom"><Button Content="+ Field" Click="AddField"/><Button Content="+ File" Click="AddFile"/></WrapPanel><DataGrid ItemsSource="{Binding SelectedCase.Parts}" CanUserDeleteRows="True"><DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="90"/><DataGridTextColumn Header="Value / base64" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="85"/><DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="85"/><DataGridCheckBoxColumn Header="Binary" Binding="{Binding Binary}"/><DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl>
  <StackPanel Grid.Row="3" Visibility="{Binding SelectedCase.BodyChanged, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"><TextBlock Text="Original body" FontStyle="Italic" Foreground="{DynamicResource Muted}"/><TextBox Text="{Binding SelectedCase.OriginalBody, Mode=OneWay}" IsReadOnly="True" MaxHeight="70" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Muted}" FontStyle="Italic"/></StackPanel>
 </Grid>
</UserControl>
