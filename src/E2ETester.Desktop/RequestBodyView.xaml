<UserControl x:Class="E2ETester.Desktop.RequestBodyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:E2ETester.Desktop">
 <ScrollViewer x:Name="BodyScroll" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Height="{Binding ViewportHeight, ElementName=BodyScroll}" MinHeight="340"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><WrapPanel><CheckBox Content="Send body" IsChecked="{Binding SelectedCase.SendBody}" Margin="0,0,12,8"/><CheckBox Content="Use session cookies" IsChecked="{Binding SelectedCase.UseCookies}" Margin="12,0,0,8"/></WrapPanel><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{x:Static local:CaseEditor.BodyKinds}" SelectedItem="{Binding SelectedCase.BodyKind}" Margin="0,0,8,0" ToolTip="Text: JSON, XML or plain text. Binary: base64. Form modes use fields; embedded files are limited to 1 MB."/><TextBox Grid.Column="1" Text="{Binding SelectedCase.ContentType}" ToolTip="Content type for text and binary bodies; form modes set their own content type."/></Grid></StackPanel>
  <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedCase.BodyTabIndex, Mode=OneWay}"><TabItem Header="Text / binary"><DockPanel><Button DockPanel.Dock="Bottom" Content="Load binary file" Click="LoadBinary" HorizontalAlignment="Left"/><TextBox x:Name="BodyEditor" Text="{Binding SelectedCase.Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
   <TabItem Header="Form / multipart"><DockPanel><WrapPanel DockPanel.Dock="Bottom"><Button Content="+ Field" Click="AddField"/><Button Content="+ File" Click="AddFile"/></WrapPanel><DataGrid ItemsSource="{Binding SelectedCase.Parts}" CanUserDeleteRows="True"><DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="90"/><DataGridTextColumn Header="Value / base64" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="85"/><DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="85"/><DataGridCheckBoxColumn Header="Binary" Binding="{Binding Binary}"/><DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl>
  <Expander x:Name="OriginalBodyExpander" Grid.Row="3" Header="Original body (changed)" Foreground="{DynamicResource Muted}" FontStyle="Italic" Visibility="{Binding SelectedCase.BodyChanged, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"><TextBox Text="{Binding SelectedCase.OriginalBody, Mode=OneWay}" IsReadOnly="True" MaxHeight="70" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Muted}" FontStyle="Italic"/></Expander>
 </Grid>
 </ScrollViewer>
</UserControl>
