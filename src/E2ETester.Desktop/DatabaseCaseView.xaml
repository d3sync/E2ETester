<UserControl x:Class="E2ETester.Desktop.DatabaseCaseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:E2ETester.Desktop">
 <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="FIXTURE QUERY" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Database.Queries}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding SelectedCase.FixtureQueryId}"/><CheckBox Content="Require fixture before sending" IsChecked="{Binding SelectedCase.FixtureRequired}" Margin="0,10,0,0"/><TextBlock Text="{Binding SelectedCase.FixtureLabel}" Foreground="{DynamicResource Muted}" Margin="0,8"/><TextBlock Text="Use {{fixture.column}} in request values. Selecting a fixture resets request values to the resolved baseline." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/><Button Content="Open Query Studio / select fixture" Command="{Binding OpenDatabase}" Margin="0,10,0,20" HorizontalAlignment="Left"/></StackPanel>
  <TextBlock Grid.Row="1" Text="POST-REQUEST DATABASE CHECKS" Style="{StaticResource Caption}"/>
  <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedCase.DatabaseChecks}" CanUserDeleteRows="True"><DataGrid.Columns>
   <DataGridTemplateColumn Header="Query" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Database.Queries, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding QueryId, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridComboBoxColumn Header="Check" ItemsSource="{x:Static local:DatabaseViewModel.CheckKinds}" SelectedItemBinding="{Binding Kind}" Width="105"/>
   <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="70"/><DataGridTextColumn Header="Expected JSON" Binding="{Binding ExpectedJson}" Width="95"/><DataGridCheckBoxColumn Header="Req." Binding="{Binding Required}" Width="40"/>
   <DataGridTextColumn Header="Poll seconds (0=once)" Binding="{Binding PollTimeoutSeconds}" Width="125"/><DataGridTextColumn Header="Interval ms" Binding="{Binding PollIntervalMilliseconds}" Width="85"/>
  </DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3"><TextBlock Text="Queries use their configured connection alias. Required checks remain INCONCLUSIVE until verified." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10"/><StackPanel Orientation="Horizontal"><Button Content="+ DB check" Command="{Binding AddDatabaseCheck}"/><Button Content="Verify selected attempt" Command="{Binding VerifyDatabase}"/></StackPanel></StackPanel>
 </Grid>
</UserControl>
