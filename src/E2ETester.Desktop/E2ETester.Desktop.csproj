<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\E2ETester.Infrastructure\E2ETester.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets/e2e-tester.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <StartupObject>E2ETester.Desktop.App</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets/e2e-tester.ico" />
    <Resource Include="../../samples/generic/cloud-checkremoteip.json" Link="Samples/cloud-checkremoteip.json" />
    <Resource Include="Assets/e2e-tester.png" />
    <Resource Include="Assets/d3sync-logo.png" />
    <Resource Include="../../LICENSE" Link="About/LICENSE" />
    <Resource Include="../../THIRD_PARTY_NOTICES.md" Link="About/THIRD_PARTY_NOTICES.md" />
    <Resource Include="../../skills/e2e-tester-author/references/generation-prompt.md" Link="Agent/generation-prompt.md" />
    <Resource Include="../../skills/e2e-tester-author/assets/test-suite.jsee" Link="Agent/test-suite.jsee" />
    <Resource Include="../../skills/e2e-tester-author/**/*" Link="AgentSkill/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
