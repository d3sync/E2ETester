    <Border x:Name="ReadinessStrip" Grid.Row="1" Margin="0,10,0,0" Padding="10,6" CornerRadius="5" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ToolTip="{Binding ReadinessDetail}"><DockPanel><Button DockPanel.Dock="Right" Content="{Binding ReadinessActionLabel}" Command="{Binding ReadinessAction}" Visibility="{Binding HasReadinessAction, Converter={StaticResource BoolVisibility}}" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding ReadinessText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding ReadinessState}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></DataTrigger><DataTrigger Binding="{Binding ReadinessState}" Value="Blocked"><Setter Property="Foreground" Value="{DynamicResource DangerInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel></Border>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel><Button Content="Prepare…" Command="{Binding PrepareCase}" Visibility="{Binding HasCasePreparation, Converter={StaticResource BoolVisibility}}"/><Button Content="{Binding SendLabel}" Command="{Binding Send}" Style="{StaticResource Primary}"/><Button x:Name="NextCaseButton" Content="Next case →" Command="{Binding Next}" MinWidth="130"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding NextIsPrimary}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="← Previous" Command="{Binding Previous}"/><CheckBox Content="Run anyway" IsChecked="{Binding RunAnyway}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="8,0" ToolTip="For this request only: bypass earlier-test pass requirements. Missing values still need to be entered; assertions and history are retained."/><Button Content="Cancel" Command="{Binding Cancel}" Margin="8,0,0,0"/></WrapPanel><Button Grid.Column="1" Content="+ Variation" Command="{Binding AddVariation}" Margin="0" VerticalAlignment="Top" ToolTip="Insert a copy of this case, with your current edits, right after it"/></Grid>
