    <Grid Visibility="{Binding IsChanged, Converter={StaticResource BoolVisibility}}" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding OriginalLabel}" FontStyle="Italic" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Restore" Command="{Binding Restore}" Padding="7,2" FontSize="11"/></Grid>
   </StackPanel></Grid></Border></DataTemplate>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource HeaderBackground}" Padding="25,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/e2e-tester.png" Width="44" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="E2E Tester · Guided API testing" AutomationProperties.Name="E2E Tester logo"/><StackPanel><TextBlock Text="E2E TESTER / WORKSPACE" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding PackageTitle}" Foreground="{DynamicResource Ink}" FontSize="19" FontWeight="SemiBold"/></StackPanel></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="{Binding ThemeLabel}" Command="{Binding ToggleTheme}" Margin="0,0,16,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding RunLabel}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right"/><TextBlock Text="{Binding Progress}" Foreground="{DynamicResource Ink}" Margin="0,6,0,0"/></StackPanel></StackPanel></Grid></Border>
  <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="22,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="Open package" Command="{Binding Import}"/><Button Content="Export package" Command="{Binding ExportPackage}"/><Button Content="Saved runs" Command="{Binding BrowseRuns}"/><Button Content="Tools ▾" Click="OpenToolsMenu" ToolTip="Open workspace, identities and app tools"><Button.ContextMenu><ContextMenu><MenuItem Header="Open saved files" Command="{Binding OpenSavedFiles}"/><MenuItem Header="Cloud test" Command="{Binding LoadCloudSample}"/><MenuItem Header="API workspace" Command="{Binding OpenPlayground}"/><MenuItem Header="Import OpenAPI request" Command="{Binding ImportOpenApi}"/><MenuItem Header="AI test generator" Command="{Binding AgentHelp}"/><Separator/><MenuItem Header="Review tester setup…" Command="{Binding ReviewTesterSetup}"/><MenuItem Header="Manage identities" Command="{Binding ManageIdentities}"/><MenuItem Header="Restore prepared changes" Command="{Binding RestorePreparation}"/><MenuItem Header="Updates and settings…" Command="{Binding OpenUpdates}"/><MenuItem Header="Keyboard shortcuts&#x2026;" Click="OpenShortcuts"/><MenuItem Header="About E2E Tester" Command="{Binding ShowAbout}"/></ContextMenu></Button.ContextMenu></Button><Button Content="Guided Actions…" Command="{Binding OpenGuidedActions}" ToolTip="Cleanup, permission changes and restoration outside the test flow"/><Button Content="Query Studio" Command="{Binding OpenDatabase}"/></StackPanel><Grid Grid.Column="1" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="BASE URL" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"/></Grid><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Restore changes" Command="{Binding RestorePreparation}" Visibility="{Binding HasPendingPreparation, Converter={StaticResource BoolVisibility}}"/><Button Content="Workspace" Command="{Binding OpenWorkspace}"/><Button Content="{Binding UpdateLabel}" Command="{Binding OpenUpdates}" ToolTip="Check for updates, configure startup checks or roll back"/><Button Content="New run" Command="{Binding NewRun}"/><CheckBox Content="Advanced" IsChecked="{Binding ShowAdvanced}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Grid></Border>
  <Grid Grid.Row="3" Margin="18,18,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="200"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="380"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.82*" MinWidth="320"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="TEST FLOW" Style="{StaticResource Caption}"/><TextBlock Text="One case at a time." Foreground="{DynamicResource Muted}" Margin="0,0,0,18"/><Expander Header="Package details" Margin="0,0,0,12" IsEnabled="{Binding CanAuthor}"><StackPanel><TextBlock Text="Title"/><TextBox Text="{Binding PackageTitle, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Description" Margin="0,8,0,0"/><TextBox Text="{Binding PackageDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="+ New case" Command="{Binding NewCase}" Margin="0,0,0,8"/><UniformGrid Columns="2" Margin="0,0,0,6"><Button Content="Duplicate" Command="{Binding DuplicateCase}"/><Button Content="Delete" Command="{Binding DeleteCase}"/><Button Content="Move up" Command="{Binding MoveCaseUp}"/><Button Content="Move down" Command="{Binding MoveCaseDown}"/></UniformGrid><Button Content="Save draft" Command="{Binding SaveDraft}" Margin="0,0,0,8"/><TextBlock Text="Variations stay beside their original test. Every send is recorded." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
    <ListBox x:Name="CaseList" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" IsHitTestVisible="{Binding CanEdit}" PreviewKeyDown="CaseListKeyDown" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CaseBorder" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CaseBorder" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="20" Height="20" Margin="0,1,10,0" VerticalAlignment="Top" ToolTip="{Binding Status}"><Ellipse x:Name="BadgeCircle" Fill="Transparent" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/><Path x:Name="BadgeMark" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Grid><StackPanel Grid.Column="1"><TextBlock Text="VARIATION" FontSize="9" Foreground="{DynamicResource AccentInk}" Visibility="{Binding IsVariation, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Outcome}" Value="Pass"><Setter TargetName="BadgeCircle" Property="Fill" Value="{DynamicResource PassBadge}"/><Setter TargetName="BadgeCircle" Property="Stroke" Value="{DynamicResource PassBadge}"/><Setter TargetName="BadgeMark" Property="Data" Value="M5.5,10.3 L8.6,13.3 L14.5,7.2"/><Setter TargetName="BadgeMark" Property="Visibility" Value="Visible"/><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource AccentInk}"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="Fail"><Setter TargetName="BadgeCircle" Property="Fill" Value="{DynamicResource FailBadge}"/><Setter TargetName="BadgeCircle" Property="Stroke" Value="{DynamicResource FailBadge}"/><Setter TargetName="BadgeMark" Property="Data" Value="M7,7 L13,13 M13,7 L7,13"/><Setter TargetName="BadgeMark" Property="Visibility" Value="Visible"/><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource DangerInk}"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="Inconclusive"><Setter TargetName="BadgeCircle" Property="Fill" Value="{DynamicResource WarnBadge}"/><Setter TargetName="BadgeCircle" Property="Stroke" Value="{DynamicResource WarnBadge}"/><Setter TargetName="BadgeMark" Property="Data" Value="M10,5.5 L10,11 M10,14.2 L10,14.3"/><Setter TargetName="BadgeMark" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="REQUEST" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedCase.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" BorderThickness="0" Padding="0,2"/><TextBox x:Name="CaseInstructions" FontSize="16" Text="{Binding SelectedCase.Instructions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0,10" Foreground="{DynamicResource Ink}" MaxHeight="150" VerticalScrollBarVisibility="Auto"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,14,0,18" IsEnabled="{Binding SelectedCase.IsHttpStep}"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox FontSize="15" ItemsSource="{x:Static local:MainViewModel.Methods}" Text="{Binding SelectedCase.Method, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,8,0"/><TextBox FontSize="15" Grid.Column="1" Text="{Binding SelectedCase.Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></Grid>
    <TabControl x:Name="RequestTabs" Grid.Row="2" IsEnabled="{Binding CanEdit}">
     <TabItem Header="Params" IsEnabled="{Binding SelectedCase.IsHttpStep}"><DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Bottom" Content="+ Parameter" Command="{Binding AddQuery}" HorizontalAlignment="Left" Margin="0,12,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedCase.Query}" ItemTemplate="{StaticResource FieldTemplate}"/></ScrollViewer></DockPanel></TabItem>
     <TabItem Header="Headers" IsEnabled="{Binding SelectedCase.IsHttpStep}"><DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Bottom" Content="+ Header" Command="{Binding AddHeader}" HorizontalAlignment="Left" Margin="0,12,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedCase.Headers}" ItemTemplate="{StaticResource FieldTemplate}"/></ScrollViewer></DockPanel></TabItem>
     <TabItem Header="Body" IsEnabled="{Binding SelectedCase.IsHttpStep}"><local:RequestBodyView/></TabItem>
     <TabItem Header="Auth"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0"><TextBlock Text="NAMED IDENTITY" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="Manage" Command="{Binding ManageIdentities}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="+" Command="{Binding NewIdentity}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Identities}" DisplayMemberPath="Alias" SelectedItem="{Binding SelectedIdentity}"/></DockPanel><TextBlock Text="A stored token may still have different permissions from this case. Review tester setup to check account and fixture assumptions." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedIdentity.SessionDescription}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12"/><Button Content="Sign in with Swagger" Style="{StaticResource Primary}" Command="{Binding OpenSwagger}" HorizontalAlignment="Left"/><TextBlock Text="Use your Microsoft account or the login offered by Swagger." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><Expander Header="Swagger address" IsExpanded="False"><TextBox Text="{Binding SwaggerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,8"/></Expander><Expander Header="Manual JWT or API token" IsExpanded="False" Margin="0,14,0,0"><StackPanel><TextBlock Text="Authentication type" Margin="0,18,0,6"/><ComboBox ItemsSource="{x:Static local:MainViewModel.AuthKinds}" SelectedItem="{Binding SelectedIdentity.Kind}" IsEnabled="{Binding SelectedIdentity.IsConfigurable}"/><TextBlock Text="Token (remembered securely after use)" Margin="0,18,0,6"/><PasswordBox x:Name="TokenBox" PasswordChanged="TokenChanged" IsEnabled="{Binding SelectedIdentity.CanEnterToken}"/><TextBlock Text="API-token header" Margin="0,18,0,6"/><TextBox Text="{Binding SelectedIdentity.HeaderName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="API-token prefix (include