</StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="Sign in with browser" Command="{Binding LoginBrowser}"/><Button Content="Forget login" Command="{Binding ForgetLogin}"/></StackPanel></StackPanel></Expander></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Checks" IsEnabled="{Binding SelectedCase.IsHttpStep}"><DockPanel Margin="0,16,0,0"><StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="+ Check" Command="{Binding AddCheck}" HorizontalAlignment="Left" ToolTip="Add a required Status 200 check, then adjust it. JSON selectors use /path/to/value; expected JSON strings need quotes; JsonSchema takes a complete schema in Expected. Select a row and press Delete to remove a check."/></StackPanel><DataGrid ItemsSource="{Binding SelectedCase.Checks}" CanUserDeleteRows="True"><DataGrid.Columns><DataGridComboBoxColumn ElementStyle="{StaticResource {x:Type ComboBox}}" EditingElementStyle="{StaticResource {x:Type ComboBox}}" Header="Check" ItemsSource="{x:Static local:MainViewModel.CheckKinds}" SelectedItemBinding="{Binding Kind}" Width="150"/><DataGridTextColumn Header="Selector (/path/to/value)" Binding="{Binding Selector}" Width="*"/><DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*"/><DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem Header="Database" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVisibility}}"><local:DatabaseCaseView/></TabItem>
     <TabItem Header="Preparation"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16"><TextBlock Text="{Binding PreparationStatus}" TextWrapping="Wrap" FontSize="16"/><WrapPanel Margin="0,14"><Button Content="Configure preparation…" Command="{Binding ConfigurePreparation}" ToolTip="Define an optional setup change (database value or API change) applied before this case. Originals are captured before applying; preparation uses a separate writable connection or administrator API identity, never Query Studio."/><Button Content="Prepare…" Command="{Binding PrepareCase}" Style="{StaticResource Primary}"/><Button Content="Restore changes" Command="{Binding RestorePreparation}"/></WrapPanel></StackPanel></ScrollViewer></TabItem><TabItem Header="Transport" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVisibility}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16"><TextBlock Text="HTTP version preference (1.1, 2.0 or 3.0)"/><TextBox Text="{Binding SelectedCase.HttpVersion}"/><TextBlock Text="A lower version may be negotiated. The response records the version used." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,16"/><CheckBox Content="Follow redirects on the same origin" IsChecked="{Binding SelectedCase.FollowRedirects}"/><TextBlock Text="Maximum redirects (0–10)" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedCase.MaxRedirects}"/><TextBlock Text="Proxy URL (blank uses system settings; no embedded credentials)" TextWrapping="Wrap" Margin="0,16,0,6"/><TextBox Text="{Binding SelectedCase.ProxyUrl}"/><TextBlock Text="Client certificate thumbprint (Current User / Personal store)" TextWrapping="Wrap" Margin="0,16,0,6"/><TextBox Text="{Binding SelectedCase.ClientCertificateThumbprint}"/><TextBlock Text="TLS certificates are always validated. Redirects to another origin require a separate case. MCP uses explicit target cases and token identities; redirects, custom proxies and client certificates are desktop-only." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16"/><TextBlock Text="RESPONSE BINDINGS" Style="{StaticResource Caption}"/><TextBlock Text="Use {{case.case-id./json/pointer}} in a URL, field or JSON string value to use a successful earlier case's response. JSON values retain their types. Use {{fixture.column}} for database fixtures." TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedCase.Baseline.Id, StringFormat=This case ID: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12"/></StackPanel></ScrollViewer></TabItem>
