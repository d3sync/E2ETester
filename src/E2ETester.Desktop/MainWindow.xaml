    <StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="REQUEST" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedCase.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" BorderThickness="0" Padding="0,2" MaxHeight="90" VerticalScrollBarVisibility="Auto"/><Expander x:Name="InstructionsExpander" IsExpanded="True" Expanded="UiPreferenceChanged" Collapsed="UiPreferenceChanged"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Instructions" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCase.InstructionsSummary}" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" MaxWidth="560" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Expander.Header><TextBox x:Name="CaseInstructions" FontSize="16" Text="{Binding SelectedCase.Instructions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0,10" Foreground="{DynamicResource Ink}" MaxHeight="150" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel>
    <Grid Grid.Row="1" Margin="0,14,0,18" IsEnabled="{Binding SelectedCase.IsHttpStep}"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox FontSize="15" ItemsSource="{x:Static local:MainViewModel.Methods}" Text="{Binding SelectedCase.Method, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,8,0"/><TextBox FontSize="15" Grid.Column="1" Text="{Binding SelectedCase.Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></Grid>
