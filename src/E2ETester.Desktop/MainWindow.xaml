</StackPanel></Expander><Expander Header="Advanced · registered OIDC client" IsExpanded="False" Margin="0,14,0,0"><StackPanel>
<TextBlock Text="A stored token may still have different permissions from this case. Review tester setup to check account and fixture assumptions." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedIdentity.SessionDescription}" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource AccentInk}"/>
<StackPanel IsEnabled="{Binding SelectedIdentity.IsConfigurable}">
<TextBlock Text="Authority (HTTPS)"/><TextBox Text="{Binding SelectedIdentity.Authority, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Registered desktop client ID"/><TextBox Text="{Binding SelectedIdentity.ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Scopes"/><TextBox Text="{Binding SelectedIdentity.Scope, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Registered callback"/><TextBox Text="{Binding SelectedIdentity.RedirectUri, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Expected subject (optional on first login; pinned afterward)"/><TextBox Text="{Binding SelectedIdentity.ExpectedSubject, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<CheckBox Content="Refresh before sending when expiry is near" IsChecked="{Binding SelectedIdentity.AutomaticRefresh}" Margin="0,8"/>
<TextBlock Text="Disable refresh only to deliberately test an expired token." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
<CheckBox Content="Allow HTTP for local 127.0.0.1 development only" IsChecked="{Binding SelectedIdentity.AllowLocalHttp}" Margin="0,8"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="Sign in with browser" Command="{Binding LoginBrowser}"/><Button Content="Forget login" Command="{Binding ForgetLogin}"/></StackPanel></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Checks" IsEnabled="{Binding SelectedCase.IsHttpStep}"><DockPanel Margin="0,16,0,0"><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="JSON selectors use /path/to/value. Expected JSON strings need quotes. JsonSchema: put a complete schema in Expected (schema 1.7). Delete removes a check." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10"/><Button Content="+ Check" Command="{Binding AddCheck}" HorizontalAlignment="Left"/></StackPanel><DataGrid ItemsSource="{Binding SelectedCase.Checks}" CanUserDeleteRows="True"><DataGrid.Columns><DataGridComboBoxColumn ElementStyle="{StaticResource {x:Type ComboBox}}" EditingElementStyle="{StaticResource {x:Type ComboBox}}" Header="Check" ItemsSource="{x:Static local:MainViewModel.CheckKinds}" SelectedItemBinding="{Binding Kind}" Width="150"/><DataGridTextColumn Header="Selector" Binding="{Binding Selector}" Width="*"/><DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*"/><DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem Header="Database" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVisibility}}"><local:DatabaseCaseView/></TabItem>
     <TabItem Header="Preparation"><StackPanel Margin="0,16"><TextBlock Text="{Binding PreparationStatus}" TextWrapping="Wrap" FontSize="16"/><WrapPanel Margin="0,14"><Button Content="Configure preparation…" Command="{Binding ConfigurePreparation}"/><Button Content="Prepare…" Command="{Binding PrepareCase}" Style="{StaticResource Primary}"/><Button Content="Restore changes" Command="{Binding RestorePreparation}"/></WrapPanel><TextBlock Text="Optional setup changes are captured before applying. Query Studio stays read-only; preparation uses a separate writable connection or administrator API identity." TextWrapping="Wrap"/></StackPanel></TabItem><TabItem Header="Transport" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVisibility}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16"><TextBlock Text="HTTP version preference (1.1, 2.0 or 3.0)"/><TextBox Text="{Binding SelectedCase.HttpVersion}"/><TextBlock Text="A lower version may be negotiated. The response records the version used." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,16"/><CheckBox Content="Follow redirects on the same origin" IsChecked="{Binding SelectedCase.FollowRedirects}"/><TextBlock Text="Maximum redirects (0–10)" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedCase.MaxRedirects}"/><TextBlock Text="Proxy URL (blank uses system settings; no embedded credentials)" TextWrapping="Wrap" Margin="0,16,0,6"/><TextBox Text="{Binding SelectedCase.ProxyUrl}"/><TextBlock Text="Client certificate thumbprint (Current User / Personal store)" TextWrapping="Wrap" Margin="0,16,0,6"/><TextBox Text="{Binding SelectedCase.ClientCertificateThumbprint}"/><TextBlock Text="TLS certificates are always validated. Redirects to another origin require a separate case. MCP uses explicit target cases and token identities; redirects, custom proxies and client certificates are desktop-only." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16"/><TextBlock Text="RESPONSE BINDINGS" Style="{StaticResource Caption}"/><TextBlock Text="Use {{case.case-id./json/pointer}} in a URL, field or JSON string value to use a successful earlier case's response. JSON values retain their types. Use {{fixture.column}} for database fixtures." TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedCase.Baseline.Id, StringFormat=This case ID: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel><Button Content="Prepare…" Command="{Binding PrepareCase}" Visibility="{Binding HasCasePreparation, Converter={StaticResource BoolVisibility}}"/><Button Content="{Binding SendLabel}" Command="{Binding Send}" Style="{StaticResource Primary}"/><CheckBox Content="Run anyway" IsChecked="{Binding RunAnyway}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="8,0" ToolTip="For this request only: bypass earlier-test pass requirements. Missing values still need to be entered; assertions and history are retained."/><Button Content="Next case →" Command="{Binding Next}" Style="{Binding Style, ElementName=NextCaseButton}" Margin="8,0,8,0"/><Button Content="Cancel" Command="{Binding Cancel}"/></WrapPanel><Button Grid.Column="1" Content="+ Variation" Command="{Binding AddVariation}" Margin="0"/></Grid>
   </Grid></Border>
   <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="4" Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions><StackPanel><TextBlock Text="EVIDENCE" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ResponseMeta}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,14"/></StackPanel><Border Grid.Row="1" Background="{DynamicResource Canvas}" CornerRadius="5" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding VerdictText}" FontWeight="Bold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Style.Triggers><DataTrigger Binding="{Binding HasFailureVerdict}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="Mark as failed…" Command="{Binding MarkAttemptFailed}" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Record a manual FAIL with your name and reason, even when automated checks pass"/></StackPanel></Border>
    <TabControl x:Name="EvidenceTabs" Grid.Row="2"><TabItem Header="Response"><DockPanel><Button DockPanel.Dock="Bottom" Content="Save captured response" Command="{Binding SaveResponse}"/><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
