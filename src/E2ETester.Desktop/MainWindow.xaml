     <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Style.Triggers><DataTrigger Binding="{Binding WrapResponse}" Value="False"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/></DataTrigger></Style.Triggers>
     </Style></TextBox.Style>
    </TextBox></DockPanel></TabItem><TabItem Header="Request / cURL"><DockPanel><Button DockPanel.Dock="Bottom" Content="Copy first request cURL" Command="{Binding CopyCurl}"/><TextBox Text="{Binding RequestDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0"/></DockPanel></TabItem><TabItem Header="Checks"><ListBox ItemsSource="{Binding SelectedAttempt.Checks}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,10"><TextBlock Text="{Binding Verdict}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="{Binding Expected, StringFormat=Expected: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Actual, StringFormat=Actual: {0}}" TextWrapping="Wrap" MaxHeight="130"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="Headers"><TextBox Text="{Binding ResponseHeaders, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="Changes"><TextBox Text="{Binding ChangesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="Database" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVisibility}}"><DockPanel><Button DockPanel.Dock="Bottom" Content="Verify database" Command="{Binding VerifyDatabase}" Margin="0,10,0,0"/><TextBox Text="{Binding DatabaseEvidenceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></DockPanel></TabItem></TabControl>
    <Expander x:Name="AttemptHistory" Grid.Row="3" Header="{Binding AttemptCountLabel}" Margin="0,12,0,0" Expanded="UiPreferenceChanged" Collapsed="UiPreferenceChanged"><StackPanel Margin="0,8,0,0"><ListBox Height="130" ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt}" BorderBrush="{DynamicResource Line}" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StartedAt, StringFormat={}{0:HH:mm:ss} UTC}"/><TextBlock Text="{Binding IdentityAlias}" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Verdict}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Expander>
   </Grid></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DockPanel VerticalAlignment="Center"><Button DockPanel.Dock="Left" Content="{x:Static local:AppInfo.VersionLabel}" Command="{Binding ShowAbout}" ToolTip="Version and About E2E Tester" Margin="0,0,12,0"/><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,18,0"/></DockPanel><StackPanel Grid.Column="1" Orientation="Horizontal">
   <Button Content="View report" Command="{Binding ViewReport}"/>
   <Button Content="Export report" Command="{Binding ExportReport}"/>
   <Button x:Name="FinishRunButton" Content="Finish run" Command="{Binding Finish}" MinWidth="130" Margin="0">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
     <Style.Triggers><DataTrigger Binding="{Binding AllCasesCompleted}" Value="True">
      <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontWeight" Value="SemiBold"/>
     </DataTrigger></Style.Triggers>
    </Style></Button.Style>
   </Button>
  </StackPanel></Grid></Border>
 <Border x:Name="ActivityBanner" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" MaxWidth="480" Margin="0,0,24,20" Padding="14" CornerRadius="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Link}" BorderThickness="2" Visibility="Collapsed">
  <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DismissActivity" ToolTip="Dismiss notification"/><StackPanel><TextBlock Text="ACTIVITY" Foreground="{DynamicResource Link}" FontWeight="Bold"/><TextBox x:Name="ActivityText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="14" MaxHeight="160" VerticalScrollBarVisibility="Auto"/></StackPanel></DockPanel>
 </Border>
 </Grid>
</Window>
