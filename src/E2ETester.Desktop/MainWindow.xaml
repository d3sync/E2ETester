     </Style></TextBox.Style>
    </TextBox></DockPanel></TabItem><TabItem Header="Request / cURL"><DockPanel><Button DockPanel.Dock="Bottom" Content="Copy first request cURL" Command="{Binding CopyCurl}"/><TextBox Text="{Binding RequestDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0"/></DockPanel></TabItem><TabItem Header="Checks"><ListBox ItemsSource="{Binding SelectedAttempt.Checks}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,10"><TextBlock Text="{Binding Verdict}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="{Binding Expected, StringFormat=Expected: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Actual, StringFormat=Actual: {0}}" TextWrapping="Wrap" MaxHeight="130"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="Headers"><TextBox Text="{Binding ResponseHeaders, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="Changes"><TextBox Text="{Binding ChangesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="Database" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVisibility}}"><DockPanel><Button DockPanel.Dock="Bottom" Content="Verify database" Command="{Binding VerifyDatabase}" Margin="0,10,0,0"/><TextBox Text="{Binding DatabaseEvidenceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></DockPanel></TabItem></TabControl>
    <DockPanel Grid.Row="3" Margin="0,14,0,8"><Button DockPanel.Dock="Right" Content="Manual assessment…" Command="{Binding ReviewAttempt}" Margin="8,0,0,0"/><TextBlock Text="ATTEMPT HISTORY" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel><ListBox Grid.Row="4" ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt}" BorderBrush="{DynamicResource Line}" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StartedAt, StringFormat={}{0:HH:mm:ss} UTC}"/><TextBlock Text="{Binding IdentityAlias}" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Verdict}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
