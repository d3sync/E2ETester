     </DataTrigger></Style.Triggers>
    </Style></Button.Style>
   </Button>
   <Button x:Name="NextCaseButton" Content="Next case →" Command="{Binding Next}" MinWidth="130">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Primary}">
     <Setter Property="Grid.Column" Value="4"/>
     <Style.Triggers><DataTrigger Binding="{Binding AllCasesCompleted}" Value="True">
      <Setter Property="Grid.Column" Value="3"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="Normal"/>
     </DataTrigger></Style.Triggers>
    </Style></Button.Style>
   </Button>
  </Grid></Grid></Border>
 <Border x:Name="ActivityBanner" Grid.Row="2" VerticalAlignment="Top" Margin="18,10,18,0" Padding="16" CornerRadius="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Link}" BorderThickness="2" Visibility="Collapsed">
  <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DismissActivity" ToolTip="Dismiss notification"/><StackPanel><TextBlock Text="ACTIVITY" Foreground="{DynamicResource Link}" FontWeight="Bold"/><TextBox x:Name="ActivityText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="14" MaxHeight="160" VerticalScrollBarVisibility="Auto"/></StackPanel></DockPanel>
 </Border>
 </Grid>
</Window>
