     <TabItem Header="Headers" IsEnabled="{Binding SelectedCase.IsHttpStep}"><DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Bottom" Content="+ Header" Command="{Binding AddHeader}" HorizontalAlignment="Left" Margin="0,12,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedCase.Headers}" ItemTemplate="{StaticResource FieldTemplate}"/></ScrollViewer></DockPanel></TabItem>
     <TabItem Header="Body" IsEnabled="{Binding SelectedCase.IsHttpStep}"><local:RequestBodyView/></TabItem>
     <TabItem Header="Auth"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0"><TextBlock Text="NAMED IDENTITY" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="Manage" Command="{Binding ManageIdentities}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="+" Command="{Binding NewIdentity}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Identities}" DisplayMemberPath="Alias" SelectedItem="{Binding SelectedIdentity}"/></DockPanel><TextBlock Text="{Binding SelectedIdentity.SessionDescription}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Ink}" Margin="0,14,0,12"/><Button Content="{Binding AuthActionLabel}" Command="{Binding AuthAction}" Visibility="{Binding HasAuthAction, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" ToolTip="Swagger: use your Microsoft account or the login offered by Swagger, then read and use the authorized token"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding AuthActionIsPrimary}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="A stored token may still have different permissions from this case. Review tester setup (Tools) to check account and fixture assumptions." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,10,0,14"/><Expander Header="Other sign-in methods and settings" IsExpanded="False"><StackPanel Margin="0,8,0,0"><Expander Header="Swagger address" IsExpanded="False"><TextBox Text="{Binding SwaggerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,8"/></Expander><Expander Header="Manual JWT or API token" IsExpanded="False" Margin="0,14,0,0"><StackPanel><TextBlock Text="Authentication type" Margin="0,18,0,6"/><ComboBox ItemsSource="{x:Static local:MainViewModel.AuthKinds}" SelectedItem="{Binding SelectedIdentity.Kind}" IsEnabled="{Binding SelectedIdentity.IsConfigurable}"/><TextBlock Text="Token (remembered securely after use)" Margin="0,18,0,6"/><PasswordBox x:Name="TokenBox" PasswordChanged="TokenChanged" IsEnabled="{Binding SelectedIdentity.CanEnterToken}"/><TextBlock Text="API-token header" Margin="0,18,0,6"/><TextBox Text="{Binding SelectedIdentity.HeaderName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Header name for API-token authentication, as given in your API documentation. Bearer uses the Authorization header automatically."/><TextBlock Text="API-token prefix (include any space)" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedIdentity.Prefix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text placed before the token value, including any trailing space. Bearer adds its prefix automatically."/>
</StackPanel></Expander><Expander Header="Advanced · registered OIDC client" IsExpanded="False" Margin="0,14,0,0"><StackPanel>
<StackPanel IsEnabled="{Binding SelectedIdentity.IsConfigurable}">
<TextBlock Text="Authority (HTTPS)"/><TextBox Text="{Binding SelectedIdentity.Authority, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Registered desktop client ID"/><TextBox Text="{Binding SelectedIdentity.ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Scopes"/><TextBox Text="{Binding SelectedIdentity.Scope, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Registered callback"/><TextBox Text="{Binding SelectedIdentity.RedirectUri, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
<TextBlock Text="Expected subject (optional on first login; pinned afterward)"/><TextBox Text="{Binding SelectedIdentity.ExpectedSubject, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
