 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource HeaderBackground}" Padding="25,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/e2e-tester.png" Width="44" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="E2E Tester · Guided API testing" AutomationProperties.Name="E2E Tester logo"/><StackPanel><TextBlock Text="E2E TESTER / WORKSPACE" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding PackageTitle}" Foreground="{DynamicResource Ink}" FontSize="19" FontWeight="SemiBold"/></StackPanel></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="{Binding ThemeLabel}" Command="{Binding ToggleTheme}" Margin="0,0,16,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding RunLabel}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right"/><TextBlock Text="{Binding Progress}" Foreground="{DynamicResource Ink}" Margin="0,6,0,0"/></StackPanel></StackPanel></Grid></Border>
  <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="22,12"><Grid x:Name="ToolbarGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="ToolbarActions" Orientation="Horizontal"><Button Content="Open package" Command="{Binding Import}"/><Button Content="Export package" Command="{Binding ExportPackage}"/><Button Content="Saved runs" Command="{Binding BrowseRuns}"/><Button Content="Tools ▾" Click="OpenToolsMenu" ToolTip="Samples, imports, workspace, identities, advanced tabs and app settings"><Button.ContextMenu><ContextMenu><MenuItem Header="Cloud test" Command="{Binding LoadCloudSample}"/><MenuItem Header="API workspace" Command="{Binding OpenPlayground}"/><MenuItem Header="Import OpenAPI request" Command="{Binding ImportOpenApi}"/><MenuItem Header="AI test generator" Command="{Binding AgentHelp}"/><Separator/><MenuItem Header="Guided Actions…" Command="{Binding OpenGuidedActions}"/><MenuItem Header="Query Studio" Command="{Binding OpenDatabase}"/><MenuItem Header="Workspace…" Command="{Binding OpenWorkspace}"/><MenuItem Header="Review tester setup…" Command="{Binding ReviewTesterSetup}"/><MenuItem Header="Manage identities" Command="{Binding ManageIdentities}"/><MenuItem Header="Restore prepared changes" Command="{Binding RestorePreparation}"/><Separator/><MenuItem Header="{Binding AdvancedMenuLabel}" Command="{Binding ToggleAdvanced}"/><MenuItem Header="Updates and settings…" Command="{Binding OpenUpdates}"/><MenuItem Header="Keyboard shortcuts&#x2026;" Click="OpenShortcuts"/><MenuItem Header="Open saved files" Command="{Binding OpenSavedFiles}"/><MenuItem Header="About E2E Tester" Command="{Binding ShowAbout}"/></ContextMenu></Button.ContextMenu></Button><Button Content="Guided Actions…" Command="{Binding OpenGuidedActions}" Visibility="{Binding HasGuidedActions, Converter={StaticResource BoolVisibility}}" ToolTip="Cleanup, permission changes and restoration outside the test flow"/><Button Content="Query Studio" Command="{Binding OpenDatabase}" Visibility="{Binding HasDatabaseWork, Converter={StaticResource BoolVisibility}}" ToolTip="Fixtures and database evidence for this package"/></StackPanel><Grid x:Name="BaseUrlPanel" Grid.Column="1" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="BASE URL" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" ToolTip="Server the requests are sent to. Frozen for the run once the first request is sent."/></Grid><StackPanel x:Name="ToolbarRunActions" Grid.Column="2" Orientation="Horizontal"><Button Content="Restore changes" Command="{Binding RestorePreparation}" Visibility="{Binding HasPendingPreparation, Converter={StaticResource BoolVisibility}}"/><Button Content="{Binding UpdateLabel}" Command="{Binding OpenUpdates}" Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolVisibility}}" ToolTip="A newer version is available. Open Updates to download and install it."/><Button Content="New run" Command="{Binding NewRun}" Margin="0" ToolTip="Start a new run with the current drafts. The previous run remains saved."/></StackPanel></Grid></Border>
  <Grid Grid.Row="3" Margin="18,18,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="200"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="380"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.82*" MinWidth="320"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"><DockPanel Margin="14"><TextBlock DockPanel.Dock="Top" Text="TEST FLOW" Style="{StaticResource Caption}" Margin="0,0,0,10"/><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Expander x:Name="EditPackage" Header="Edit package" IsEnabled="{Binding CanAuthor}" Expanded="UiPreferenceChanged" Collapsed="UiPreferenceChanged" ToolTip="Add, duplicate, reorder or delete cases and edit the package title. Available before a run starts."><StackPanel Margin="0,8,0,0"><Expander Header="Package details" Margin="0,0,0,10"><StackPanel><TextBlock Text="Title"/><TextBox Text="{Binding PackageTitle, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Description" Margin="0,8,0,0"/><TextBox Text="{Binding PackageDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander><Button Content="+ New case" Command="{Binding NewCase}" Margin="0,0,0,8"/><UniformGrid Columns="2" Margin="0,0,0,6"><Button Content="Duplicate" Command="{Binding DuplicateCase}"/><Button Content="Delete" Command="{Binding DeleteCase}"/><Button Content="Move up" Command="{Binding MoveCaseUp}"/><Button Content="Move down" Command="{Binding MoveCaseDown}"/></UniformGrid><TextBlock Text="Variations stay beside their original test. Every send is recorded." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Expander><Button Content="Save draft" Command="{Binding SaveDraft}" Margin="0,10,0,0" ToolTip="Save the local draft now. Edits are also saved automatically while you work."/></StackPanel>
    <ListBox x:Name="CaseList" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" IsHitTestVisible="{Binding CanEdit}" PreviewKeyDown="CaseListKeyDown" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CaseBorder" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CaseBorder" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="20" Height="20" Margin="0,1,10,0" VerticalAlignment="Top" ToolTip="{Binding Status}"><Ellipse x:Name="BadgeCircle" Fill="Transparent" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/><Path x:Name="BadgeMark" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Grid><StackPanel Grid.Column="1"><TextBlock Text="VARIATION" FontSize="9" Foreground="{DynamicResource AccentInk}" Visibility="{Binding IsVariation, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Outcome}" Value="Pass"><Setter TargetName="BadgeCircle" Property="Fill