<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.8.5</Version>
    <Authors>d3sync and E2E Tester contributors</Authors>
    <Company>d3sync</Company>
    <Product>E2E Tester</Product>
    <Copyright>Copyright (c) 2026 d3sync and E2E Tester contributors</Copyright>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(PackagingRestore)' == 'true'">$(MSBuildProjectDirectory)/obj/packages.publish.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
